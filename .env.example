# Copy to .env and fill in. Never commit .env.
# Every key below maps to a field in src/common/settings.py, or to an
# os.environ read in src/ marked (env-read). Unset keys fall back to the
# defaults shown in comments.

# MinIO / S3 (docker-compose.yml also uses MINIO_ROOT_USER/PASSWORD)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://localhost:9000
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above. Leave these empty and
# the S3A warehouse below refuses to start (config.py raises on a credentialless
# s3a:// warehouse), so a plain `cp .env.example .env` works only if these match.
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me

# Nessie catalog
NESSIE_HOST=localhost
NESSIE_PORT=19120
NESSIE_REF=main
NESSIE_API_VERSION=v2

# Redpanda / Kafka
REDPANDA_HOST=localhost
KAFKA_BROKER=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:8081
TOPIC_NAME=gateway_webhooks

# Spark — single node local[*] only
# 8g driver / 128 shuffle partitions is the measured-good pair for the 12.6M-row
# real batch; 2g/32 OOMs on a 16GB box. Lower BOTH on a small machine (a JVM
# cannot start if driver memory exceeds free RAM).
SPARK_MODE=local
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=8g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_SHUFFLE_PARTITIONS=128
# (env-read) 1 adds -XX:TieredStopAtLevel=1 to the driver and executor JVMs.
# It starts short local runs sooner and costs throughput on long ones.
SPARK_TIERED_STOP=
# Jar packages default to the full Iceberg/Kafka/Nessie/S3 list in settings.py.
# Leave commented unless overriding; an empty value DISABLES all jars.
# SPARK_JAR_PACKAGES=
LOAD_CSV_ON_DRIVER=false

# Iceberg warehouse (single node, MinIO S3)
ICEBERG_WAREHOUSE=s3a://lakehouse/warehouse

# Tables (TABLE_PREFIX=glue retargets nessie.db.* to glue.db.* for AWS)
WEBHOOK_TABLE=nessie.db.webhooks
DLQ_TABLE=nessie.db.webhooks_dlq
TABLE_PREFIX=

# Maintenance (see docs/RUNBOOK.md; 0 skips the post-MERGE run)
MAINTAIN_AFTER_MERGE=1

# Fee engine — rates live in FEE_RATE_CONFIG, never in env.
FEE_RATE_CONFIG=config/fee_rates.yaml

# Fail-closed gates. STRICT_SLO defaults true: a sub-SLO batch raises.
# These are the knobs that hard-fail a run, so they are spelled out here
# rather than left to an invisible default.
STRICT_SLO=true
MATCH_RATE_SLO=0.95          # (env-read) batch match rate below this fails the batch
LATE_SLA_DAYS=7              # (env-read) overrides the per-provider late_sla_days in providers.yaml
ALLOW_DESTRUCTIVE_SEED=false # real-data seeding runs MERGE-DELETE
# (env-read) 1 lets reconcile read the raw drop instead of the curated file.
# Off by default: a raw file has not passed Pandera or the PAN guard.
ALLOW_UNVALIDATED_SETTLEMENT=false
# (env-read) quarantined rows as a share of the batch; above this the batch
# fails. 0 means any quarantine at all fails it.
QUARANTINE_MAX_PCT=0

# Fee-rate fallbacks (an unparseable or out-of-range settlement date, a
# merchant with no negotiated rate, an instrument outside the vocabulary) are
# counted in the batch record and logged as one warning. Off by default,
# because a dated-out settlement is normal on real data and refusing every
# such batch would stop the pipeline rather than inform anyone. Set to 1 to
# refuse the batch instead, before the MERGE runs.
STRICT_FEE_RATES=false
MAINTAIN_RETAIN_LAST=7       # (env-read) snapshots kept; the mart is always expired to 1

# Optional reconciliation legs (empty = all on). The bank leg reads third-party
# MT940 evidence, so it fails open when the file is absent; wap and residual
# are ours and stay on. Narrow to e.g. "bank" to skip the other two.
WIRED_LEGS=

# Kafka transport. PLAINTEXT means the broker trusts forgeable records.
# Nothing here is enforced unless the matching REQUIRE_* flag is set.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
REQUIRE_KAFKA_SASL=false
REQUIRE_SCHEMA_REGISTRY=false
# WEBHOOK_SECRET is INERT — see SECURITY.md. No signature is emitted and
# nothing calls verify_webhook; it exists for a gateway edge outside this repo.
WEBHOOK_SECRET=

# Mounted-file alternatives. File wins over an empty env value, explicit env
# wins over the file. Use these instead of inline secrets in shared deploys.
# MINIO_SECRET_KEY_FILE=/run/secrets/minio_secret_key
# WEBHOOK_SECRET_FILE=/run/secrets/webhook_secret
# KAFKA_SASL_PASSWORD_FILE=/run/secrets/kafka_sasl_password

# Streaming
STREAM_WATERMARK_DELAY=1 day      # event-time bound for the late-row gauge
STREAM_STARTING_OFFSETS=latest    # only used when no checkpoint exists
# STREAM_CHECKPOINT_LOCATION=      # empty -> {iceberg_warehouse}/checkpoints/webhooks_all

# Project
PROJECT_ROOT=.

# Bench tuning (empty = production defaults)
BENCH_MODE=
BENCH_SHUFFLE=
BENCH_WAREHOUSE=

# Set automatically by their environments; only override to debug
# AIRFLOW_HOME=
# JAVA_HOME=
# SPARK_HOME=
# (env-read) scripts/mutation_score.py. CI sets it per job; the script's own
# default is the 80 it was written against.
# MUTATION_SCORE_MIN=80

# Dashboard sync (scripts/refresh_dashboard.py). Values stay out of git.
# METABASE_URL=http://127.0.0.1:3001
# METABASE_USER=admin@tx-recon.local
# METABASE_PASSWORD=
# METABASE_DB_ID=2
