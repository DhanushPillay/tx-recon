# Copy to .env and fill in. Never commit .env.
# MinIO / S3
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Nessie
NESSIE_HOST=localhost
NESSIE_PORT=19120
NESSIE_REF=main
# Redpanda / Kafka
KAFKA_BROKER=localhost:19092
SCHEMA_REGISTRY_URL=http://localhost:8081
TOPIC_NAME=gateway_webhooks
# Spark
SPARK_MODE=local
SPARK_MASTER=local[*]
TABLE_PREFIX=
PROJECT_ROOT=.
# Fee engine
FEE_RATE_CONFIG=config/fee_rates.yaml
# Grafana Alloy remote write (optional, for observability)
GRAFANA_REMOTE_WRITE_URL=
GRAFANA_USERNAME=
GRAFANA_API_KEY=
